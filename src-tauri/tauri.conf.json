{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "época",
  "version": "0.1.0",
  "identifier": "com.uyen288.epoca",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "época — everything at a glance",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Không gian làm việc cá nhân local-first",
    "category": "Productivity"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:epoca.db"]
    }
  }
}
